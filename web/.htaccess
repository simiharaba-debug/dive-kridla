ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
DirectoryIndex index.php
Options -Indexes

# --- interné súbory nikdy nie sú dostupné z webu ---
<FilesMatch "^(\.env.*|.*\.(sqlite|sqlite-wal|sqlite-shm|sql|md|example|ini|gitignore)|router\.php)$">
  Require all denied
</FilesMatch>
RewriteEngine On

# Jedna adresa webu: www → bez www (dôležité pre vyhľadávače)
RewriteCond %{HTTP_HOST} ^www\.(divekridla\.sk)$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
# http → https (Webglobe: SSL ukončuje nginx a posiela X-Forwarded-Proto; zapnuté 26. 11. 2026, bez slučky overené)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{REQUEST_URI} !^/\.well-known/
# Cron Webglobe volá http:// a nemusí sledovať presmerovanie; cron-zaloha povoľuje iba IP Cronu Webglobe
RewriteCond %{REQUEST_URI} !^/cron-zaloha\.php$
RewriteRule ^ https://divekridla.sk%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^(storage|includes|data|migrations|bin)(/|$) - [F,L]

# Skryté prípony: staré adresy /stranka.php → 301 na /stranka, /index.php → / (iba GET/HEAD, nie api/)
# REDIRECT_STATUS prázdny = nie pri internom presmerovaní na chybovú stránku (403/404 → 404.php)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s(\S*?/)index\.php[\s?]
RewriteRule ^(.*/)?index\.php$ %1 [R=301,L,NE]
# cieľ s lomkou na začiatku – inak Apache do presmerovania vloží cestu na disku servera
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \.php[\s?]
RewriteRule ^((?!api/|cron-zaloha\.php).+?)\.php$ /$1 [R=301,L]

# Adresy bez prípony .php (napr. /odchyt-holubov)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Limity nahrávania (ak PHP beží ako Apache modul; pri PHP-FPM pozri .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 200M
  php_value post_max_size 210M
  php_value max_execution_time 300
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|mp4|webm|woff2|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  # llms.txt a robots.txt sú v UTF-8 (slovenská diakritika)
  AddCharset UTF-8 .txt .webmanifest
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css text/javascript application/javascript image/svg+xml
</IfModule>
