# Skopíruj na .env a vyplň. Súbor .env NIKDY nezverejňuj ani nenahrávaj do verejného repozitára.
# --- Administrátor ---
# Vytvorí sa / heslo sa zmení príkazom: php bin/sync-admin-password.php  (START-WEB.bat to robí automaticky)
ADMIN_USERNAME=
ADMIN_EMAIL=
# aspoň 10 znakov, písmeno + číslo; zvoľ vlastné silné heslo
ADMIN_PASSWORD=

# --- Adresa webu a vyhľadávače (includes/seo.php) ---
# SITE_URL=https://divekridla.sk
# GOOGLE_VERIFICATION=kód zo Search Console (metóda „Značka HTML“)
# BING_VERIFICATION=

# --- Voliteľné ---
# DB_PATH=/cesta/mimo/webroot/app.sqlite
# DB_DSN=pgsql:host=localhost;dbname=divekridla   (pozri README – migrácie sú písané pre SQLite)
# DB_USER=
# DB_PASS=
# MAX_IMAGE_MB=15
# MAX_VIDEO_MB=150
# Za reverzným proxy (HTTPS ukončuje proxy): 1
# TRUST_PROXY=1
# Vynútiť Secure cookie aj bez detekcie HTTPS: 1
# COOKIE_SECURE=1

# --- E-mail z kontaktného formulára (SMTP cez PHPMailer) ---
# Bez týchto údajov formulár správu NEODOŠLE a návštevníkovi to férovo oznámi.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=tls, SMTP_USER=celá gmail adresa,
#        SMTP_PASS=16-miestne „heslo aplikácie“ (Google účet → Zabezpečenie → 2-krokové overenie → Heslá aplikácií).
# Seznam: smtp.seznam.cz / 465 / ssl.  Websupport: smtp.m1.websupport.sk / 465 / ssl.
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (port 465) | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Odosielateľ (musí ho SMTP server povoliť – pri Gmaile rovnaká adresa ako SMTP_USER). Prázdne = SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Web OZ Divé krídla
# Kam chodia správy z formulára. Prázdne = daniel.haraba@gmail.com (data/site.php).
MAIL_TO=
# Súkromná galéria administrátora (predvolene storage/private-media – mimo webu)
# PRIVATE_MEDIA_DIR=/cesta/mimo/webroot/private-media
